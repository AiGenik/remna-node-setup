#!/usr/bin/env bash
set -euo pipefail
umask 077

PROJECT_DIR=$(cd -- "$(dirname -- "$(realpath -- "$0")")" && pwd -P)
CONFIG_DIR=/etc/remna-node-setup
STATE_DIR=/var/lib/remna-node-setup
NODE_DIR=/opt/remna-node-setup-node
BACKUP_DIR=/var/backups/remna-node-setup
NODE_SECRET=$CONFIG_DIR/node.secret

# shellcheck source=lib/common.sh
source "$PROJECT_DIR/lib/common.sh"
# shellcheck source=lib/ui.sh
source "$PROJECT_DIR/lib/ui.sh"
# shellcheck source=lib/release.sh
source "$PROJECT_DIR/lib/release.sh"
# shellcheck source=lib/node.sh
source "$PROJECT_DIR/lib/node.sh"
# shellcheck source=lib/selfsteal.sh
source "$PROJECT_DIR/lib/selfsteal.sh"
# shellcheck source=lib/selfsteal-nginx.sh
source "$PROJECT_DIR/lib/selfsteal-nginx.sh"
# shellcheck source=lib/security.sh
source "$PROJECT_DIR/lib/security.sh"
# shellcheck source=lib/vpn-port.sh
source "$PROJECT_DIR/lib/vpn-port.sh"
# shellcheck source=lib/traffic-guard.sh
source "$PROJECT_DIR/lib/traffic-guard.sh"
# shellcheck source=lib/transaction.sh
source "$PROJECT_DIR/lib/transaction.sh"
# shellcheck source=lib/manager.sh
source "$PROJECT_DIR/lib/manager.sh"
# shellcheck source=lib/standalone.sh
source "$PROJECT_DIR/lib/standalone.sh"
# shellcheck source=lib/auto-update.sh
source "$PROJECT_DIR/lib/auto-update.sh"
# shellcheck source=lib/psiphon.sh
source "$PROJECT_DIR/lib/psiphon.sh"
# shellcheck source=lib/psiphon-profile.sh
source "$PROJECT_DIR/lib/psiphon-profile.sh"
# shellcheck source=lib/updates.sh
source "$PROJECT_DIR/lib/updates.sh"
# shellcheck source=lib/port-preflight.sh
source "$PROJECT_DIR/lib/port-preflight.sh"

# Only the SSH launcher and its controlled release handoff assign this ticket.
SSH_MENU_TICKET=
SSH_PANEL_PROBE_HOST=
REMNA_INTRO_MODE=default
remna_no_intro_flag=no
remna_args=()
for arg do
    case "$arg" in
        --no-intro)
            remna_no_intro_flag=yes
            REMNA_INTRO_MODE=off
            export REMNA_NO_INTRO=1
            UI_NO_ANIMATION=yes
            ;;
        --demo-intro)
            if [[ $remna_no_intro_flag != yes ]]; then
                REMNA_INTRO_MODE=demo
            fi
            ;;
        *)
            remna_args+=("$arg")
            ;;
    esac
done
if (( ${#remna_args[@]} > 0 )); then
    set -- "${remna_args[@]}"
else
    set --
fi
if [[ $REMNA_INTRO_MODE == demo && $remna_no_intro_flag != yes ]]; then
    unset REMNA_NO_INTRO
fi

usage() {
    cat <<'HELP'
Remna Node Setup

  remna-node-setup                     Меню
  remna-node-setup --no-intro          Запуск без вступительной анимации (или REMNA_NO_INTRO=1)
  remna-node-setup --demo-intro        Полная демо-анимация при запуске (~15 с)
  remna-node-setup install            Настроить ноду, защиту и выбранные компоненты
  remna-node-setup install node-only  Установить только Docker и ноду
  remna-node-setup selfsteal [caddy|nginx] Настроить веб-сервер для self-steal
  remna-node-setup security           Настроить входящие порты, UFW и Fail2Ban
  remna-node-setup security boot      Восстановить автозапуск UFW и TrafficGuard
  remna-node-setup vpn-port           Перенести VPN на другой TCP-порт
  remna-node-setup vpn-port profile СТАРЫЙ НОВЫЙ  Заменить порт в JSON из stdin
  remna-node-setup bbr                 Включить BBR и fq
  remna-node-setup ipv6 [disable|enable|status]  Отключить или включить IPv6
  remna-node-setup status              Статус
  remna-node-setup doctor              Диагностика настроек и сервисов
  remna-node-setup audit               Полный аудит (Gemini, YouTube, Certbot dry-run)
  remna-node-setup versions            Таблица установленных и свежих версий
  remna-node-setup preflight           Проверить порты и связь с панели до установки
  remna-node-setup dns [домен]         Проверить A/AAAA и IP этого VPS
  remna-node-setup logs                Последние сообщения ноды
  remna-node-setup backup              Сохранить конфигурацию
  remna-node-setup restore ID          Восстановить снимок
  remna-node-setup update tool [vX.Y.Z] Обновить скрипт с GitHub
  remna-node-setup update node          Обновить до стабильной версии ноды
  remna-node-setup update packages [пакет] Обновить установленные пакеты через APT
  remna-node-setup update traffic-guard Обновить TrafficGuard и список сканеров
  remna-node-setup update all           Обновить установленные компоненты
  remna-node-setup auto-updates [enable|disable|status] Управлять автообновлениями
  remna-node-setup psiphon               Настроить локальный выход Psiphon
  remna-node-setup psiphon status        Проверить Psiphon
  remna-node-setup psiphon profile [IP]  Сформировать шаблон Gemini для Remnawave
  remna-node-setup psiphon profile-merge [IP]  Добавить ноду в JSON профиля из stdin
  remna-node-setup update psiphon        Обновить управляемый Psiphon
  remna-node-setup rollback tool        Вернуть предыдущую версию скрипта
  remna-node-setup rollback            Отменить ожидающее подтверждения изменение
  remna-node-setup confirm             Подтвердить из нового SSH-сеанса
HELP
}

self_test() {
    local name
    for name in node_apply node_verify node_restore_runtime node_release_image selfsteal_apply selfsteal_verify \
        nginx_selfsteal_apply nginx_selfsteal_stop security_apply security_preflight security_detect_vpn_ports \
        apt_install_current apt_upgrade_installed_preview apt_upgrade_installed_apply \
        security_prompt_vpn_ports security_vpn_status security_os_updates_status bbr_apply ipv6_apply \
        traffic_guard_prepare traffic_guard_apply traffic_guard_capture_runtime traffic_guard_restore_before_ufw \
        traffic_guard_restore_after_ufw release_update release_rollback release_acquire_lock install_wizard restore_snapshot \
        load_host_settings standalone_selfsteal standalone_security standalone_bbr standalone_ipv6 standalone_traffic_guard \
        configure_ipv6 auto_update_enabled psiphon_configure psiphon_is_managed psiphon_select_settings \
        psiphon_apply_settings psiphon_profile psiphon_profile_merge psiphon_outbound \
        vpn_port_wizard update_all show_versions audit_live standalone_port_preflight ui_splash_intro; do
        declare -F "$name" >/dev/null || { fail "Не загружен модуль $name."; return 1; }
    done
    [[ -r $PROJECT_DIR/lib/secret-input.py ]] || { fail 'Модуль ввода ключа отсутствует.'; return 1; }
    [[ -r $PROJECT_DIR/lib/selfsteal-dns.py ]] || { fail 'Модуль проверки DNS отсутствует.'; return 1; }
    [[ -r $PROJECT_DIR/lib/port-probe.py ]] || { fail 'Модуль сетевой проверки отсутствует.'; return 1; }
    [[ -r $PROJECT_DIR/lib/splash.py ]] || { fail 'Модуль заставки отсутствует.'; return 1; }
    if command -v python3 >/dev/null 2>&1; then
        python3 "$PROJECT_DIR/lib/splash.py" --self-check || { fail 'Модуль заставки неисправен.'; return 1; }
    fi
    [[ -s $PROJECT_DIR/templates/index.html ]] || { fail 'Шаблон страницы self-steal отсутствует.'; return 1; }
    [[ -r $PROJECT_DIR/templates/robots.txt && -r $PROJECT_DIR/templates/favicon.svg ]] ||
        { fail 'Вспомогательные файлы страницы self-steal отсутствуют.'; return 1; }
    jq -e 'type == "object" and (.version | test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))' "$PROJECT_DIR/versions.json" >/dev/null
}

case "${1-}" in
    --help|-h|help) usage; exit ;;
    --version) version_get version; exit ;;
    --self-test) self_test; exit ;;
    --supports-ssh-menu|--supports-panel-probe) exit 0 ;;
esac

if [[ $REMNA_INTRO_MODE == demo && $# == 0 ]]; then
    if ! ensure_host >/dev/null 2>&1; then
        ui_init || UI_VERSION=
        ui_splash_intro demo
        exit $?
    fi
fi

ensure_host
install -d -m 0700 -- "$CONFIG_DIR" "$STATE_DIR" "$BACKUP_DIR"

if [[ ${1-} == __network-timeout ]]; then
    release_acquire_lock nowait || exit 1
    rollback_pending "${2-}"
    exit
fi

ui_init
case "${1-}" in
    __ssh-menu)
        [[ $# -ge 2 && $# -le 4 && $UI_INTERACTIVE == yes ]] && valid_ssh_ticket "$2" || exit 2
        ssh_transport_start >/dev/null || { fail 'Откройте меню через remna-ssh с другого компьютера.'; exit 1; }
        SSH_MENU_TICKET=$2
        notice=
        if [[ $# == 4 ]]; then SSH_PANEL_PROBE_HOST=$(check_probe_destination "$4") || exit 2; fi
        previous=${3-}
        if [[ -n $previous && $previous != - ]]; then
            dispatch __ssh-confirm "$previous"
            notice='Сеть подтверждена по SSH.'
            UI_INTRO_SHOWN=yes
        elif [[ $REMNA_INTRO_MODE != off ]]; then
            ui_splash_intro "$REMNA_INTRO_MODE" || exit $?
        fi
        show_menu "$notice"
        exit
        ;;
    __auto-update)
        [[ $# == 1 ]] || exit 2
        auto_update_enabled || exit 0
        release_acquire_lock nowait || exit 0
        auto_update_enabled || exit 0
        if [[ -n $(pending_id) ]]; then
            info 'Автообновление пропущено. Сеть ждёт подтверждения SSH.'
            exit 0
        fi
        update_all auto
        exit
        ;;
    __apply-updates)
        [[ ( $# == 3 || $# == 4 ) && $2 =~ ^(manual|auto)$ && $3 =~ ^[01]$ ]] || exit 2
        if [[ $# == 4 ]]; then
            [[ $2 == manual ]] && valid_ssh_ticket "$4" || exit 2
            SSH_MENU_TICKET=$4
        fi
        if [[ ! $RELEASE_LOCK -ef /proc/self/fd/9 ]] || ! flock -xn 9; then
            fail 'Обновление потеряло блокировку. Запустите его ещё раз.'
            exit 1
        fi
        if [[ $2 == auto ]]; then auto_update_enabled || exit 0; fi
        require_no_pending
        apply_combined_updates "$2" "$3"
        exit
        ;;
esac
if (( $# == 0 )); then
    if [[ $REMNA_INTRO_MODE != off ]]; then
        ui_splash_intro "$REMNA_INTRO_MODE" || exit $?
    fi
    show_menu
    exit
fi
if [[ $REMNA_INTRO_MODE == demo ]]; then
    ui_splash_intro demo || exit $?
fi
dispatch "$@"
